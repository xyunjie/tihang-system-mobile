{
  "globalStyle": {
    "navigationStyle": "default",
    "navigationBarTitleText": "正在加载",
    "navigationBarBackgroundColor": "@bar-bg-color",
    "navigationBarTextStyle": "@text-color",
    "backgroundColor": "@bg-color"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^fg-(.*)": "@/components/fg-$1/fg-$1.vue",
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#018d71",
    "backgroundColor": "#F8F8F8",
    "borderStyle": "black",
    "height": "50px",
    "fontSize": "10px",
    "iconWidth": "24px",
    "spacing": "3px",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "icon": "i-carbon-home",
        "iconType": "unocss"
      },
      {
        "pagePath": "pages/workspace/index",
        "text": "工作台",
        "icon": "i-carbon-workspace",
        "iconType": "unocss"
      },
      {
        "pagePath": "pages/contact/index",
        "text": "通讯录",
        "icon": "i-carbon-user-multiple",
        "iconType": "unocss"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "icon": "i-carbon-user",
        "iconType": "unocss"
      }
    ]
  },
  "pages": [
    {
      "path": "pages/index/index",
      "type": "home",
      "layout": "tabbar",
      "style": {
        "navigationStyle": "default",
        "navigationBarTitleText": "梯航小助手",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/bind/index",
      "type": "page",
      "layout": "default",
      "style": {
        "navigationStyle": "default",
        "navigationBarTitleText": "绑定账号"
      },
      "notLogin": true
    },
    {
      "path": "pages/contact/index",
      "type": "page",
      "layout": "tabbar",
      "style": {
        "navigationStyle": "default",
        "navigationBarTitleText": "通讯录",
        "enablePullDownRefresh": true,
        "navigationBarBackgroundColor": "#2563eb",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/login/callback",
      "type": "page",
      "layout": "default",
      "style": {
        "navigationStyle": "default",
        "navigationBarTitleText": "正在登录",
        "enablePullDownRefresh": false,
        "disableScroll": true
