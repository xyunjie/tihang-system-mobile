# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false
VITE_H5_ROUTER_MODE = history
# 第一个请求地址
VITE_SERVER_BASEURL = 'https://api.tihangstudio.cn'
# 第二个请求地址
VITE_API_SECONDARY_URL = 'https://api.tihangstudio.cn'

VITE_UPLOAD_BASEURL = 'https://api.tihangstudio.cn/upload'

VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://api.tihangstudio.cn'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://api.tihangstudio.cn'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://api.tihangstudio.cn'

VITE_UPLOAD_BASEURL__WEIXIN_DEVELOP = 'https://api.tihangstudio.cn/upload'
VITE_UPLOAD_BASEURL__WEIXIN_TRIAL = 'https://api.tihangstudio.cn/upload'
VITE_UPLOAD_BASEURL__WEIXIN_RELEASE = 'https://api.tihangstudio.cn/upload'